#!/usr/bin/env bash
# Test stub for NiftySeg seg_LabFusion.
echo "seg_LabFusion $*" >> "${STUB_LOG:-/dev/null}"
if [[ ",${STUB_FAIL:-}," == *",seg_LabFusion,"* ]]; then
    echo "stub: forced failure of seg_LabFusion" >&2
    exit 3
fi
while [[ $# -gt 0 ]]; do
    [[ $1 == -out ]] && echo stub > "$2"
    shift
done
