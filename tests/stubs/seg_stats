#!/usr/bin/env bash
# Test stub for NiftySeg seg_stats. The -d output follows what maper's jc() parses.
# STUB_DICE / STUB_MEAN set the Dice value of label 1 and the mean line;
# STUB_SEG_STATS_OUT, if set, replaces the whole -d output (printf %b escapes apply).
echo "seg_stats $*" >> "${STUB_LOG:-/dev/null}"
case " $* " in
    *" -r "*) echo "0 10" ;;
    *" -d "*)
        if [[ -n ${STUB_SEG_STATS_OUT+x} ]] ; then
            printf '%b' "$STUB_SEG_STATS_OUT"
        else
            printf 'L[1] = %s\nL[2] = 0.7\nM = %s\n' "${STUB_DICE:-0.8}" "${STUB_MEAN:-0.75}"
        fi ;;
esac
