### Fusion if numbers suffice

fuse() {
    fused="$1" ; shift
    nfuse="$1" ; shift
    first="$1" ; shift
    seg_maths "$first" -merge $(( nfuse - 1 )) 4 "$@" merged.nii
    seg_LabFusion -in merged.nii -MV -out "$fused"
    rm merged.nii
}

# fuse_if_ready <label set>: fuse the results of the label set if there are enough
# of them and it has not been done. Runs while the fusion lock is held.
fuse_if_ready() {
    local i=$1 f nready thisseg ref sep max
    local -a results=()
    for f in "$baseoutdir/$tgtid"/*-"$tgtid"/seg/"$i".nii.gz ; do
        if [[ -s $f ]] ; then results+=("$f") ; fi
    done
    nready=${#results[@]}
    [[ $nready -ge $atlasn ]] || return 0

    # Fuse output
    thisseg="$baseoutdir"/f$nready-"$i"-$tgtid
    [[ ! -s $thisseg.nii.gz ]] || return 0
    fuse "$thisseg".nii.gz "$nready" "${results[@]}"

    # Generate tissue-class separated output
    if [[ -z $notc ]] ; then
        if [[ -z $dryrun ]] ; then
            read -r _ max <<< "$(seg_stats "$thisseg.nii.gz" -r)"
            sep=$(( max + 1 ))
            seg_maths tgt/crisp.nii.gz -mul $sep -add "$thisseg".nii.gz "$thisseg"-tcsep-at$sep.nii.gz
            cp tgt/crisp.nii.gz "$thisseg-tc3crisp.nii.gz"
        fi

        # Compare fused with reference
        ref=${targetseg["$i"]}
        if [[ -s $ref ]] ; then
            jc "$ref" "$thisseg".nii.gz "$thisseg"-indivjc.csv "$thisseg"-meanjc.csv
        fi
    fi
}

# Of all the jobs for a target, the last one to deliver its results has to do the
# fusion, and only one job may do it. Each job therefore
#   1. leaves a marker: "my results are in place, somebody has to look",
#   2. tries to take the lock (see "The fusion lock"), also over a dead holder's; if
#      another job holds it, it is done -- the holder is responsible for the marker, see 4,
#   3. as lock holder removes the marker, and only then counts the results; every
#      result published before the marker was made is therefore counted,
#   4. lets go of the lock and looks at the marker again. If one has appeared in the
#      meantime, a job that found the lock taken relies on this job: it starts over.
# Counting before taking the lock, or not looking again after letting go, loses the
# fusion when the last two jobs finish at about the same time.
if [[ $atlasn -ge 3 ]] ; then
    for i in "${!sourceseg[@]}" ; do
        lock="$baseoutdir/fusion-semaphore-$i-$tgtid"
        pending="$baseoutdir/fusion-pending-$i-$tgtid"
        : > "$pending"
        while try_lock "$lock" || { break_stale_lock "$lock" && try_lock "$lock" ; } ; do
            fusion_lock=$lock
            start_heartbeat "$lock"
            rm -f "$pending"
            fuse_if_ready "$i"
            drop_lock "$lock"
            stop_heartbeat
            fusion_lock=
            [[ -e $pending ]] || break
        done
    done
fi

