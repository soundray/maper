#!/usr/bin/env bash

ppath=$(realpath "${BASH_SOURCE[0]}")
pdir=$(dirname "$ppath")
pname=$(basename "$ppath")

set -e

# shellcheck source=generic-functions
. "$pdir"/generic-functions

startsec=$(date +%s)

usage() {
    cat <<EOF

    MAPER - Calculate robust registration between a source-target pair, transform label images to target,
            fuse result from multiple transformations to same target if available.

    Usage: $pname -srcid SourceID -tgtid TargetID <src_spec> <tgt_spec> -output-dir /path/to/write/output

           $pname -h | --help
              Show this text.

    <source_spec> consists of either

       [-srcop src-onepad.nii.gz]

       or

       [-srcmri src-mri.nii.gz]

          plus

          [-srcmask src-brainmask.nii.gz]
             If -srcmri is specified without -srcmask, a skullstripped image is assumed.
             If -srcop is specified, its own masking takes precedence.

    [-srctc3raw src-three-tissue-class-probmap.nii.gz]
       If not provided, this will be calculated.

    [-spn pretransformation.dof.gz]
       This will be combined with the inverse of -tpn to achieve prealignment.

    [-srclabels name1:labelset1.nii.gz]

    [-srclabels name2:labelset2.nii.gz]
       Up to four allowed -- will be transformed according to registration result.

    [-srccache cache-dir/]
       Location for storing intermediate files for later re-use

    <target_spec>

        [-tgtop tgt-onepad.nii.gz]

        [-tgtmri tgt-mri.nii.gz]

        [-tgtmask tgt-brainmask.nii.gz]

        [-tgttc3raw tgt-three-tissue-class-probmap.nii.gz]

        treated analogously to corresponding <source_spec> items.

    [-tpn pretransformation.dof.gz]
       Obligatory if -spn specified. Either is ignored unless both are specified.

    [-tgtlabels name1:labelset1.nii.gz]

    [-tgtlabels name2:labelset2.nii.gz]
       These will be used as reference for overlap assessment of transformed labels

    [-tgtcache cache-dir/]
       Location for storing intermediate files for later re-use. Should normally be
       different from -srccache

    [-atlasn NN]
          If NN source transformations are found for TargetID in -output-dir,
          label fusion will be performed.

    [-tc3out]
       Raw three-class tissue probability map for target image will be saved
       (compressed file size is ca. 5 × input image)

    [-tc3crisp]
       Discrete three-class tissue map for target image will be saved

    [-tc3only]
       Exit after tc3 generation

    [-notc]
       Skip tissue mapping and tissue-class based prealignment

    [-notc3]
       (Deprecated) Skip tissue mapping and tissue-class based prealignment

    [-tc3]
       Perform three-class (CSF, GM, WM) tissue mapping and prealign on this basis

    [-tc2]
       Perform three-class (CSF, GM, WM) tissue mapping and prealign on the basis
       of two tissue classes (CSF and merged GMWM)

    [-threads N]
       Number of threads for MIRTK and NiftySeg (positive integer, default 1)

    [-quicktest]
       For accelerated run (very coarse result)

    [-dry-run]
       Test if options correctly specified. No results are written to -output-dir
       or to the caches (-debug still saves the working directory). Performs
       label fusion of already existing results if
       -atlasn is also specified (without the tissue-class based output, which
       needs tissue maps that a dry run does not compute).

    [-verbose]
       To show registration output on stdout

    [-debug]
       To save temporary working directory to -output-dir location

EOF
}

### Check for MIRTK and NiftySeg

type mirtk >/dev/null 2>&1 || fatal "MIRTK not found. Please ensure mirtk binary is on executable path."
type seg_maths >/dev/null 2>&1 || fatal "NiftySeg not found. Please ensure seg_maths is on executable path."

### Parameters

quicktest=
srcop=null
srcmri=null
srclabelspecs=()
srcmask=null
srctc3raw=null
spn=$pdir/neutral.dof.gz
srccache=
tgtop=null
tgtmri=null
tgtmask=null
tgtlabelspecs=()
tgttc3raw=null
tpn=$pdir/neutral.dof.gz
tgtcache=
outdir=$PWD/maper-$$
atlasn=
tc2=0
tc3=0
tc3out=
tc3crisp=
tc3only=0
notc=
notc3=
debug=
threads=1

# Absolute path of a file argument. realpath fails when a parent directory is
# missing; fall back to the argument as given so require_file can report it.
abspath() { realpath -- "$1" 2>/dev/null || printf '%s\n' "$1" ; }

# Options that take a value, so that a missing value is reported by name
valopts=" -srcid -srcop -srcmri -srctc3raw -srcmask -srclabels -spn -srccache"
valopts+=" -tgtid -tgtop -tgtmri -tgttc3raw -tgtmask -tgtlabels -tpn -tgtcache"
valopts+=" -output-dir -atlasn -threads "

while [ $# -gt 0 ]
do
    if [[ $valopts == *" $1 "* && $# -lt 2 ]] ; then
        fatal "Parameter error: option $1 requires a value"
    fi
    case "$1" in
	-h|--help)       usage ; exit 0 ;;
	-srcid)          srcid="$2" ; shift ;;
	-srcop)          srcop=$(abspath "$2") ; shift ;;
	-srcmri)        srcmri=$(abspath "$2") ; shift ;;
	-srctc3raw)  srctc3raw=$(abspath "$2") ; shift ;;
	-srcmask)      srcmask=$(abspath "$2") ; shift ;;
	-srclabels)   srclabelspecs+=("$2") ; shift ;;
	-spn)              spn=$(abspath "$2") ; shift ;;
	-srccache)    srccache=$(realpath "$2") ; shift ;;
	-tgtid)          tgtid="$2" ; shift ;;
	-tgtop)          tgtop=$(abspath "$2") ; shift ;;
	-tgtmri)        tgtmri=$(abspath "$2") ; shift ;;
	-tgttc3raw)  tgttc3raw=$(abspath "$2") ; shift ;;
	-tgtmask)      tgtmask=$(abspath "$2") ; shift ;;
	-tgtlabels)   tgtlabelspecs+=("$2") ; shift ;;
	-tpn)              tpn=$(abspath "$2") ; shift ;;
	-tgtcache)    tgtcache=$(realpath "$2") ; shift ;;
	-output-dir)    outdir=$(realpath "$2") ; shift ;;
	-atlasn)        atlasn="$2" ; shift ;;
	-threads)      threads="$2" ; shift ;;
  -tc2)              tc2=1 ;;
  -tc3)              tc3=1 ;;
	-tc3out)        tc3out=1 ;;
	-tc3crisp)    tc3crisp=1 ;;
	-tc3only)      tc3only=1 ;;
	-notc)            notc=1 ;;
	-notc3)          notc3=1 ;;
	-dry-run)       dryrun=1 ;;
	-quicktest)  quicktest=1 ;;
	-verbose)      verbose=1 ;;
	-debug)          debug=1 ;;
	-*)
	    fatal "Unknown option: $1" ;;
	*)
	    fatal "Unexpected argument: $1" ;;
    esac
    shift
done

[[ -n $srcid ]] || fatal "Parameter error: -srcid is required"
[[ -n $tgtid ]] || fatal "Parameter error: -tgtid is required"
[[ $threads =~ ^[1-9][0-9]*$ ]] || fatal "Parameter error: -threads requires a positive integer, got '$threads'"
[[ -z $atlasn || $atlasn =~ ^[0-9]+$ ]] || fatal "Parameter error: -atlasn requires a number, got '$atlasn'"

require_file() { [[ $2 == null || -e $2 ]] || fatal "Parameter error: file for $1 not found: $2" ; }
require_file -srcop "$srcop"
require_file -srcmri "$srcmri"
require_file -srcmask "$srcmask"
require_file -srctc3raw "$srctc3raw"
require_file -spn "$spn"
require_file -tgtop "$tgtop"
require_file -tgtmri "$tgtmri"
require_file -tgtmask "$tgtmask"
require_file -tgttc3raw "$tgttc3raw"
require_file -tpn "$tpn"

export OMP_NUM_THREADS=$threads

# Timing of the fusion lock, see "The fusion lock"
lock_heartbeat=${MAPER_LOCK_HEARTBEAT:-15}
lock_timeout=${MAPER_LOCK_TIMEOUT:-300}
[[ $lock_heartbeat =~ ^[1-9][0-9]*$ ]] || die "MAPER_LOCK_HEARTBEAT must be a positive number of seconds, got '$lock_heartbeat'"
[[ $lock_timeout =~ ^[1-9][0-9]*$ ]] || die "MAPER_LOCK_TIMEOUT must be a positive number of seconds, got '$lock_timeout'"
[[ $lock_timeout -gt $(( 2 * lock_heartbeat )) ]] \
    || die "MAPER_LOCK_TIMEOUT ($lock_timeout) must be longer than twice MAPER_LOCK_HEARTBEAT ($lock_heartbeat)"

[[ $notc3 == 1 ]] && notc=1

[[ $notc == 1 && $(( tc3out + tc3crisp + tc3only )) -gt 0 ]] && fatal "Parameter error: -notc (-notc3) is incompatible with -tc3 options"

[[ $(( tc2 + tc3 )) -gt 1 ]] && fatal "Parameter error: only one of -tc2 and -tc3 is permitted"

[[ $tc3 == 0 ]] && tc2=1

# Label sets are given as name:file. Everything after the first colon is the path.
parse_labelspecs() { # <array-name> <option> <kind: Source|Target> <spec>...
    local -n result=$1 ; shift
    local option=$1 ; shift
    local kind=$1 ; shift
    local spec name file
    for spec in "$@" ; do
        name=${spec%%:*} ; file=${spec#*:}
        [[ $spec == *:* && -n $name && -n $file ]] \
            || fatal "Parameter error: $option expects name:file, got '$spec'"
        [[ -e $file ]] || fatal "Parameter error: $kind segmentation '$name' does not exist: $file"
        # shellcheck disable=SC2034  # assigns to the array that "result" refers to
        result["$name"]=$(realpath "$file")
    done
}

declare -A sourceseg
parse_labelspecs sourceseg -srclabels Source "${srclabelspecs[@]}"
[[ ${#sourceseg[@]} -lt 1 ]] && msg "No source segmentation defined"

declare -A targetseg
parse_labelspecs targetseg -tgtlabels Target "${tgtlabelspecs[@]}"

baseoutdir=$outdir
outdir="$outdir/$tgtid/$srcid-$tgtid"

### Functions

progress() {
    local inp=$*
    if [[ -z $verbose ]] ; then
        echo -n .
    else
        msg "$inp"
    fi
}

tc3() { ### Tissue classification
    local input outdir bn tdl
    input=$(realpath "$1") ; shift
    # Expected: mri.nii.gz mask.nii.gz pre.dof.gz
    # Optional: tc3raw.nii.gz
    outdir=$(realpath "$1") ; shift

    bn=$(basename "$input")
    tdl=$(mktemp -d tc3."$bn".XXXXX)
    cd "$tdl"

    if [[ -n $dryrun ]] ; then
	      ( cd "$outdir"
	        for i in csf gm wm gmwm wmr wml gmwmr gmwml crisp-csf crisp-gm crisp-wm crisp tc3 ; do
		          touch $i.nii.gz
	        done
	      )
	      cd ..
	      return
    fi

    seg_maths "$input"/mask.nii.gz mask.nii.gz

    if [[ -s "$input"/tc3raw.nii.gz ]] ; then
	      cp "$input"/tc3raw.nii.gz tc3raw.nii.gz
    else
	      seg_maths "$input"/mri.nii.gz brain
	      seg_EM -in brain -out tc3raw.nii.gz -bc_out bcout -nopriors 3 -mask mask.nii.gz
	      cp tc3raw.nii.gz "$outdir"
    fi

    # Prepare left and right masks
    mirtk transform-image "$pdir"/rightmask.nii.gz rightmask-custom.nii.gz -invdof "$input"/pre.dof.gz -target mask.nii.gz
    seg_maths rightmask-custom.nii.gz -sub 1 -abs leftmask-custom.nii.gz

    # Generate crisp labels
    seg_maths tc3raw -tpmax -add mask crisp
    seg_maths crisp -thr 0.5 -uthr 1.5 "$outdir"/crisp-csf.nii.gz
    seg_maths crisp -thr 1.5 -uthr 2.5 "$outdir"/crisp-gm.nii.gz
    seg_maths crisp -thr 2.5 -uthr 3.5 "$outdir"/crisp-wm.nii.gz
    seg_maths crisp "$outdir"/crisp.nii.gz

    # Get individual tc probability maps, subsample
    seg_maths tc3raw -tp 0 -mul 254 csf-pre
    seg_maths mask -dil 6 -add csf-pre csf.nii.gz
    seg_maths tc3raw.nii.gz -tp 1 -mul 255 gm.nii.gz
    seg_maths tc3raw.nii.gz -tp 2 -mul 255 wm.nii.gz
    seg_maths gm.nii.gz -sub wm.nii.gz -abs -add gm.nii.gz -add wm.nii.gz -div 2 gmwm.nii.gz
    seg_maths wm.nii.gz -mul rightmask-custom.nii.gz wmr.nii.gz
    seg_maths wm.nii.gz -mul leftmask-custom.nii.gz wml.nii.gz
    seg_maths gmwm.nii.gz -mul rightmask-custom.nii.gz gmwmr.nii.gz
    seg_maths gmwm.nii.gz -mul leftmask-custom.nii.gz gmwml.nii.gz
    seg_maths csf.nii.gz -merge 2 4 gm.nii.gz wm.nii.gz -div 255 "$outdir"/tc3.nii.gz
    seg_maths csf.nii.gz -merge 1 4 gmwm.nii.gz -div 255 "$outdir"/tc2.nii.gz
    cp csf.nii.gz "$outdir"/csf.nii.gz
    cp gm.nii.gz "$outdir"/gm.nii.gz
    cp wm.nii.gz "$outdir"/wm.nii.gz
    cp gmwm.nii.gz "$outdir"/gmwm.nii.gz
    cp wmr.nii.gz "$outdir"/wmr.nii.gz
    cp wml.nii.gz "$outdir"/wml.nii.gz
    cp gmwmr.nii.gz "$outdir"/gmwmr.nii.gz
    cp gmwml.nii.gz "$outdir"/gmwml.nii.gz
    cd ..
}

regprop() {  ### Registration and label propagation
    local src="$1" ; shift
    local tgt="$1" ; shift
    local outdir=$1 ; shift
    #
    local dof="$outdir"/src-tgt.dof.gz
    local srcseg="$src"/srcseg.nii.gz
    local autosegdir="$outdir"/seg/
    #
    local tdl
    tdl=$(mktemp -d regprop.XXXXX)
    cd "$tdl"
    cp "$pdir"/neutral.dof.gz .
    ds=2.5 ; [[ $quicktest ]] && ds=10
    #
    if [[ -z $dryrun ]] ; then
	      if [[ ! -s "$dof" ]] ; then
            #
	          mirtk compose-dofs "$src"/pre.dof.gz "$tgt"/pre.dof.gz prealign.dof.gz -scale 1 -1
	          mirtk convert-dof prealign.dof.gz prealign.txt -input-format rigid -output-format aladin
            #
	          if [[ $notc == 1 ]] ; then lastrigidlevel=1 ; else lastrigidlevel=4 ; fi
            #
	          mirtk register \
		              "$tgt"/mri.nii.gz "$src"/mri.nii.gz -dofout coarse0-0.dof.gz \
		              -model Rigid -levels 4 "$lastrigidlevel" -threads "$threads"
            #
	          mirtk register \
		              "$tgt"/mri.nii.gz "$src"/mri.nii.gz -dofin prealign.dof.gz -dofout coarse0-1.dof.gz \
		              -model Rigid -levels 4 "$lastrigidlevel" -threads "$threads"
            #
	          topnmi=$(
		            for i in neutral prealign coarse0-0 coarse0-1 ; do
		                nmi=$(mirtk evaluate-similarity "$tgt"/mri.nii.gz "$src"/mri.nii.gz \
					                      -metric NMI -noid -csv -precision 7 \
					                      -dofin $i.dof.gz | tail -n 1)
		                echo "$nmi,$i"
		            done | sort -rn | head -n 1 | cut -d , -f 2
		              )
            msg "$topnmi is optimal"
	          cp "$topnmi".dof.gz coarse0.dof.gz
            #
	          if [[ -z $notc ]] ; then
                if [[ $tc3 == 1 ]] ; then
		                mirtk register \
                          "$tgt"/wmr.nii.gz "$tgt"/wml.nii.gz \
                          "$src"/wmr.nii.gz "$src"/wml.nii.gz \
                          -dofin coarse0.dof.gz -dofout coarse1.dof.gz -bg -1 -model Affine+FFD -levels 4 4 \
                          -par "Energy function" "0.5 SSD(I1, I3 o T) + 0.5 SSD(I2, I4 o T) + 1e-3 BE(T)" \
		                      -ds "$ds" -threads "$threads"
		                mirtk register \
                          "$tgt"/csf.nii.gz "$tgt"/gm.nii.gz \
                          "$src"/csf.nii.gz "$src"/gm.nii.gz \
                          -dofin coarse1.dof.gz -dofout coarse.dof.gz -bg -1 -model Affine+FFD -levels 3 2 \
                          -par "Energy function" "0.6 SSD(I1, I3 o T) + 0.4 SSD(I2, I4 o T) + 1e-3 BE(T)" \
		                      -ds "$ds" -threads "$threads"
                fi
                if [[ $tc2 == 1 ]] ; then
                    mirtk register \
                          "$tgt"/gmwmr.nii.gz "$tgt"/gmwml.nii.gz \
                          "$src"/gmwmr.nii.gz "$src"/gmwml.nii.gz \
                          -dofin coarse0.dof.gz -dofout coarse1.dof.gz -bg -1 -model Affine+FFD -levels 4 4 \
                          -par "Energy function" "0.5 SSD(I1, I3 o T) + 0.5 SSD(I2, I4 o T) + 1e-3 BE(T)" \
		                      -ds "$ds" -threads "$threads"
		                mirtk register \
                          "$tgt"/csf.nii.gz "$src"/csf.nii.gz \
                          -dofin coarse1.dof.gz -dofout coarse.dof.gz -bg -1 -model Affine+FFD -levels 3 2 \
                          -par "Energy function" "SSD(I1, I2 o T) + 1e-3 BE(T)" \
		                      -ds "$ds" -threads "$threads"
                fi
		            nextlevel=2
	          else
		            mirtk register "$tgt"/onepad.nii.gz "$src"/onepad.nii.gz \
                      -dofin coarse0.dof.gz -dofout coarse.dof.gz -bg -1 -model Affine -levels 4 1 \
		                  -threads "$threads"
		            nextlevel=4
	          fi
            #
	          mirtk register "$tgt"/onepad.nii.gz "$src"/onepad.nii.gz \
	    	          -dofin coarse.dof.gz -dofout fine.dof.gz \
	    	          -bg 0 -model FFD -levels "$nextlevel" 1 -ds "$ds" -threads "$threads" \
	    	          -par "Strict step length range" "No" \
	    	          -par "Maximum streak of rejected steps" 2
	          cp fine.dof.gz "$dof"
            #
	          if [[ $debug ]] ; then
		            mirtk transform-image "$src"/crisp.nii.gz prealign.nii -dofin prealign.dof.gz -target "$tgt"/crisp.nii.gz
		            # shellcheck disable=SC2046  # unquoted on purpose: word splitting puts the lines of the table on one line
		            echo -e $(mirtk evaluate-label-overlap "$tgt"/crisp.nii.gz prealign.nii -precision 3 -table | tail -n +2 | cut -d , -f 2,3,12)"\t "
		            for i in coarse0 coarse1 fine ; do
		                mirtk transform-image "$src"/crisp.nii.gz $i.nii -dofin $i.dof.gz -target "$tgt"/crisp.nii.gz
		                # shellcheck disable=SC2046  # unquoted on purpose: word splitting puts the lines of the table on one line
		                echo -e $(mirtk evaluate-label-overlap "$tgt"/crisp.nii.gz $i.nii -precision 3 -table | tail -n +2 | cut -d , -f 2,3,12)"\t "
		            done
		            echo
	          fi
	      fi
    fi
    #
    # c=0
    for i in "${!sourceseg[@]}" ; do
	      srcseg=${sourceseg["$i"]}
	      if [[ -s $srcseg ]] ; then
	          autoseg="$autosegdir"/$i.nii.gz
	          [[ -s "$autoseg" ]] && continue
	          [[ -n $dryrun ]] && continue
	          mirtk transform-image "$srcseg" "$autoseg" \
		              -dofin "$dof" -target "$tgt"/onepad.nii.gz -interp "NN" -threads "$threads"
	      fi
        ref=${targetseg[$i]}
        if [[ -s $ref ]] ; then
            jc "$ref" "$autoseg" "$autosegdir/$i"-jc.csv "$autosegdir/$i"-meanjc.csv
        fi
    done
    #
    cd ..
}

# d2j <dice>: the Jaccard index J = D / (2 - D) that goes with a Dice coefficient
# D between 0 and 1, with six decimals (bc truncates). seg_stats may write D in
# scientific notation (1.5e-05), which bc cannot read: only such a value goes
# through printf, a plain decimal is handed to bc exactly as written. Prints NA
# and returns 1 if D is not a number between 0 and 1.
d2j() {
    local d=$1
    if [[ $d =~ ^([0-9]+\.?[0-9]*|\.[0-9]+)([eE][-+]?[0-9]+)?$ ]] ; then
        if [[ -n ${BASH_REMATCH[2]} ]] ; then d=$(LC_ALL=C printf '%.20f' "$d") ; fi
        # printf writes inf for an exponent beyond its range
        if [[ $d =~ ^([0-9]+\.?[0-9]*|\.[0-9]+)$ && $(echo "$d <= 1" | bc -l) == 1 ]] ; then
            echo "scale=6; $d / (2 - $d)" | bc -l
            return
        fi
    fi
    echo NA
    return 1
}

# jc <reference> <labels> <individual.csv> <mean.csv>: overlap of a label image
# with its reference as Jaccard indices, from the Dice values of seg_stats -d.
# The lines of the seg_stats output that matter look like "L[<label>] = <dice>"
# for each label and "M = <dice>" for the mean. Everything after the = is the
# value as written, so that an exponent keeps its "e".
# The body is a subshell on purpose: jc cds into a scratch directory, and the
# caller (regprop, the fusion loop) relies on its own working directory.
jc() (
    local refseg=$1 ; shift
    local tgtseg=$1 ; shift
    local indcsv=$1 ; shift
    local avgcsv=$1 ; shift
    local tmpdir line lhs value region j mean=
    tmpdir=$(mktemp -d jc.XXXX)
    cd "$tmpdir" || exit 1
    echo %%%%% JC %%%%%
    seg_stats "$refseg" -d "$tgtseg" >stats.txt || msg "Warning: seg_stats failed on $tgtseg, no overlap values"
    {
        echo "region,jc"
        while IFS= read -r line || [[ -n $line ]] ; do
            [[ $line == *=* ]] || continue
            lhs=${line%%=*}
            read -r value _ <<<"${line#*=}"
            if [[ $lhs == *M* ]] ; then mean=$value ; continue ; fi
            region=${lhs//[][a-zL[:space:]]/}
            if ! j=$(d2j "$value") ; then
                msg "Warning: Dice value '$value' for label $region of $tgtseg is not a number between 0 and 1"
            fi
            echo "$region, $j"
        done <stats.txt
    } >"$indcsv"
    if [[ -z $mean ]] ; then
        msg "Warning: no mean Dice value in the seg_stats output for $tgtseg"
        j=NA
    elif ! j=$(d2j "$mean") ; then
        msg "Warning: mean Dice value '$mean' for $tgtseg is not a number between 0 and 1"
    fi
    echo "$j" >"$avgcsv"
)

onepadgen() {
    local mri mask onepad tmpdir
    mri=$(realpath "$1") ; shift
    mask=$(realpath "$1") ; shift
    onepad=$(realpath "$1") ; shift
    local side=$1 ; shift   # src or tgt, for error messages
    local label=Source ; [[ $side == tgt ]] && label=Target
    local incomplete="$label specification incomplete. Either [-${side}op file] or [-${side}mri fileA -${side}mask fileB] must be provided on commandline."

    tmpdir=$(mktemp -d onepadgen.XXXX)
    cd "$tmpdir" || exit 1

    echo "MRI: $mri"
    echo "MASK: $mask"
    echo "ONEPAD: $onepad"

    # Check existence
    local has_op=0 has_mask=0 has_mri=0
    [[ -s "$onepad" ]] && has_op=1
    [[ -s "$mask" ]] && has_mask=1
    [[ -s "$mri" ]] && has_mri=1

    case "$has_op$has_mask$has_mri" in
        111)
            echo "Case 1: All necessary files exist. Nothing to do." ;;

        110)
            echo "Case 2: Generating MRI from onepad"
            mirtk calculate-element-wise "$onepad" -mask "$mask" -map 1 0 -o "$mri" -threads "$threads" ;;

        101)
            echo "Case 3: Generating mask from onepad (MRI untouched)"
            mirtk calculate-element-wise "$onepad" -map 1 0 -o tmp-mri.nii -threads "$threads"
            seg_maths tmp-mri.nii -bin -fill "$mask" ;;

        100)
            echo "Case 4: Generating MRI and mask from onepad"
            mirtk calculate-element-wise "$onepad" -map 1 0 -o "$mri" -threads "$threads"
            seg_maths "$mri" -bin -fill "$mask" ;;

        011)
            echo "Case 5: Generating onepad from MRI and mask"
            cp "$mask" mask.nii.gz
            mirtk dilate-image mask.nii.gz mask-dil.nii -iterations 6
            mirtk calculate-element-wise "$mri" -mask mask.nii.gz -pad 0 -o brain.nii.gz -threads "$threads"
            mirtk calculate-element-wise mask-dil.nii -sub mask.nii.gz -add brain.nii.gz -o "$onepad" float -threads "$threads" ;;

        010)
            echo "Case 6: Error - mask provided without MRI or onepad"
            fatal "$incomplete" ;;

        001)
            echo "Case 7: Generating mask and onepad from masked MRI"
            seg_maths "$mri" -bin -fill "$mask"
            mirtk dilate-image "$mask" mask-dil.nii -iterations 6
            mirtk calculate-element-wise mask-dil.nii -sub "$mask" -add "$mri" -o "$onepad" float -threads "$threads" ;;

        000)
            echo "Case 8: Error - no files provided"
            fatal "$incomplete" ;;

        *)
            fatal "Unexpected combination of inputs: OP:$has_op MASK:$has_mask MRI:$has_mri" ;;
    esac

    cd ..
}

### Publishing files to places other jobs look at
#
# Jobs of the same target run at the same time and read each other's output: the
# fusion counts and reads the results in the output directory, and every job looks
# into the shared caches. Whatever lands there must be complete from the first
# moment it can be seen, so it is written under a temporary name next to its
# destination and then renamed, which is atomic.

# publish <file> <destination file>
publish() {
    local tmp="$2.tmp.$$"
    if cp "$1" "$tmp" && mv -f "$tmp" "$2" ; then return 0 ; fi
    rm -f "$tmp"
    return 1
}

# stage_out <directory> <destination>: publish every file below <directory>
stage_out() {
    local f
    while IFS= read -r -d '' f ; do mkdir -p "$2/$f" ; done < <(cd "$1" && find . -type d -print0)
    while IFS= read -r -d '' f ; do publish "$1/$f" "$2/$f" ; done < <(cd "$1" && find . -type f -print0)
}

# install_dir <directory> <destination>: give the directory the name <destination>, which
# nothing has, in one step; fails if <destination> exists. Only what POSIX has is used, so
# this works with the mv of macOS and the other BSDs: they have no -T ("<destination> is the
# new name, not a directory to move into"). Where <destination> exists as a directory, mv
# puts <directory> inside it, and that is a failure -- taken back out again.
install_dir() {
    local base=${1##*/}
    [[ ! -e $2 ]] || return 1
    mv "$1" "$2" 2>/dev/null || return 1
    if [[ -e $2/$base ]] ; then rm -rf "${2:?}/$base" ; return 1 ; fi
}

# publish_cache <directory with the files> <cache directory>
# The cache directory is created empty at the start, and a job that finds fewer than
# nine files in it generates them itself. The full directory takes its place in one
# step (an empty directory makes way for it). If another job was first, its directory
# stays: both hold the same files.
# A cache that cannot be written is not an error, only slower.
publish_cache() {
    local tmp
    if ! tmp=$(mktemp -d "$2.tmp.XXXXXX") || ! cp "$1"/* "$tmp"/ ; then
        msg "Warning: could not write the cache $2 -- not caching"
        if [[ -n $tmp ]] ; then rm -rf "$tmp" ; fi
        return 0
    fi
    rmdir "$2" 2>/dev/null || true
    if ! install_dir "$tmp" "$2" ; then
        rm -rf "$tmp"
        if [[ -z $(ls -A "$2" 2>/dev/null) ]] ; then msg "Warning: could not publish the cache $2 -- not caching" ; fi
    fi
}

